PORT=4000
WORKSPACE_ID=default

# Provider principal: auto | openrouter | ollama | mock
AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Protecao: shell fica desligado ate voce ativar explicitamente.
ALLOW_SHELL=false

# Defina uma frase longa para criptografar segredos locais.
SECRET_STORE_PASSPHRASE=
